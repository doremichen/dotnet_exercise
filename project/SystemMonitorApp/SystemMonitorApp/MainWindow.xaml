<Window x:Class="SystemMonitorApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SystemMonitorApp"
        mc:Ignorable="d"
        Title="系統監控" Height="450" Width="800">
    <StackPanel Margin="20" Orientation="Vertical">
        <TextBlock Text="CPU 使用率：" FontWeight="Bold"/>
        <ProgressBar x:Name="cpuBar" Height="20" Maximum="100"/>
        <TextBlock x:Name="cpuText" Margin="0,5"/>

        <TextBlock Text="記憶體使用：" FontWeight="Bold" Margin="0,10,0,0"/>
        <ProgressBar x:Name="ramBar" Height="20" Maximum="100"/>
        <TextBlock x:Name="ramText" Margin="0,5"/>

        <TextBlock Text="硬碟使用：" FontWeight="Bold" Margin="0,10,0,0"/>
        <ItemsControl x:Name="diskInfoList"/>

        <WrapPanel Margin="0,10,0,0">
            <Button Content="最佳化記憶體 (Service)" Margin="0,0,10,0" Height="30" Width="180" Click="TriggerServiceGC_Click"/>
            <Button Content="取得程序清單" Margin="0,0,10,0" Height="30" Width="120" Click="RequestProcessList_Click"/>
            <TextBlock VerticalAlignment="Center" Margin="10,0,0,0">更新間隔 (秒):</TextBlock>
            <ComboBox x:Name="intervalCombo" Width="80" Margin="5,0,0,0" SelectionChanged="IntervalCombo_SelectionChanged">
                <ComboBoxItem>1</ComboBoxItem>
                <ComboBoxItem>2</ComboBoxItem>
                <ComboBoxItem>5</ComboBoxItem>
                <ComboBoxItem>10</ComboBoxItem>
            </ComboBox>
        </WrapPanel>

        <ListView x:Name="processListView" Height="120" Margin="0,10,0,0">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="PID" DisplayMemberBinding="{Binding Id}" Width="60"/>
                    <GridViewColumn Header="Name" DisplayMemberBinding="{Binding ProcessName}" Width="200"/>
                    <GridViewColumn Header="RAM (MB)" DisplayMemberBinding="{Binding WorkingSetMB}" Width="100"/>
                </GridView>
            </ListView.View>
        </ListView>

        <Button Content="關閉應用程式" Margin="0,5,0,0" Height="30" Width="150" HorizontalAlignment="Left" Click="CloseApp_Click"/>
    </StackPanel>
</Window>
